# Copy this file to .env for local testing (Render/Railway: set these in their dashboard instead).

# Make up any random string — you'll enter the SAME value in the Meta App Dashboard webhook setup.
VERIFY_TOKEN=choose_a_random_string_here

# Meta App Dashboard > App settings > Basic > App Secret
APP_SECRET=

# Page access token for the Facebook Page linked to your Instagram professional account
# (Meta App Dashboard > your app > Instagram > API setup with Instagram business login,
# or Graph API Explorer — see README for exact steps)
PAGE_ACCESS_TOKEN=

# The single fixed message every DM will get. Leave blank to use the built-in default.
AUTO_REPLY_TEXT=Hey! 👋 Thanks for reaching out to Marklix! We've got your message and someone from our team will get back to you shortly. Talk soon! 🚀

# How many hours before the SAME person can receive the auto-reply again
RESET_HOURS=24

PORT=3000

# --- Vowframe CRM integration (optional — leave blank to skip CRM saving) ---
# Every DM creates/updates an Enquiry in your CRM automatically when these are set.
CRM_SITE_URL=https://crm.marklix.in
CRM_USERNAME=fyzoomedia
# WordPress Application Password (Users > Profile > Application Passwords)
CRM_APP_PASSWORD=
